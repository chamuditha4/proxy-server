# --- Client-facing endpoint -------------------------------------------------
# Port clients connect to. Username picks the exit node, password is this value.
GATEWAY_PORT=8899
GATEWAY_PASS=change-me-long-random

# --- Discovery --------------------------------------------------------------
# How the gateway finds nodes: tailscale | netbird | cloudflare | static
DISCOVERY_BACKEND=netbird

# Shared by every backend.
# Mesh hostname "proxy-de-1" -> node "de-1" -> proxy username "de-1".
NODE_NAME_PREFIX=proxy-
NODE_PORT=8899
ANY_KEYWORD=any
SYNC_INTERVAL=60
HEALTH_INTERVAL=30
HEALTH_TIMEOUT=3

# -- DISCOVERY_BACKEND=netbird ----------------------------------------------
# Personal access token (Settings > Tokens). Peers in NODE_GROUP become nodes.
NETBIRD_TOKEN=
NODE_GROUP=proxy-node
# Change only when self-hosting NetBird.
NETBIRD_API_URL=https://api.netbird.io

# -- DISCOVERY_BACKEND=tailscale --------------------------------------------
TAILNET=-
# Either an API key (expires every 90 days)...
TAILSCALE_API_KEY=
# ...or an OAuth client with devices:core:read (preferred, does not expire).
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
NODE_TAG=tag:proxy-node

# -- DISCOVERY_BACKEND=cloudflare -------------------------------------------
# Nodes are Cloudflare Tunnels advertising a private /32 route. Read the
# README caveats before choosing this backend.
CF_ACCOUNT_ID=
# Needs Account > Cloudflare Tunnel:Read + Zero Trust:Read. The DNS token
# below is zone-scoped and cannot read tunnels, so this is usually separate.
CF_DISCOVERY_TOKEN=
CF_VIRTUAL_NETWORK_ID=

# -- DISCOVERY_BACKEND=static ------------------------------------------------
# For plain WireGuard, Nebula, or a cloud VPC. Nodes are still health checked.
STATIC_NODES=
# STATIC_NODES=de-1=10.8.0.1,us-1=10.8.0.2:8899
STATIC_NODES_FILE=

# --- Cloudflare DNS sync ----------------------------------------------------
# The gateway keeps this A record pointed at its own public IP. Independent of
# DISCOVERY_BACKEND -- use it with any mesh. Omit to disable.
CF_API_TOKEN=
PROXY_HOSTNAME=proxy.example.com
# Provide either the zone ID or the zone (root domain) name.
CF_ZONE_ID=
CF_ZONE_NAME=example.com
DNS_TTL=60
DNS_SYNC_INTERVAL=300
# Set only if public IP autodetection is wrong.
PUBLIC_IP=

# --- Optional ---------------------------------------------------------------
# Only if your nodes run their own basic auth. Read the README caveat first.
NODE_PROXY_USER=
NODE_PROXY_PASS=

STATUS_PORT=9000
