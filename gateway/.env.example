# --- Client-facing endpoint -------------------------------------------------
# Port clients connect to. Username picks the exit node, password is this value.
GATEWAY_PORT=8899
GATEWAY_PASS=change-me-long-random

# --- Tailscale discovery ----------------------------------------------------
# Your tailnet name, e.g. example.com or your-org.github. "-" means "the
# tailnet that owns the credentials below" and is usually correct.
TAILNET=-
# Either a plain API key...
TAILSCALE_API_KEY=
# ...or an OAuth client (recommended: keys expire after 90 days, OAuth doesn't).
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
# Only devices carrying this tag are treated as proxy nodes.
NODE_TAG=tag:proxy-node
# Stripped from the Tailscale hostname to form the node name:
# hostname "proxy-de-1" -> node "de-1" -> username "de-1"
NODE_NAME_PREFIX=proxy-
NODE_PORT=8899
# Username that means "any healthy node".
ANY_KEYWORD=any

SYNC_INTERVAL=60
HEALTH_INTERVAL=30
HEALTH_TIMEOUT=3

# --- Cloudflare DNS sync ----------------------------------------------------
# The gateway keeps this A record pointed at its own public IP.
CF_API_TOKEN=
PROXY_HOSTNAME=proxy.example.com
# Provide either the zone ID or the zone (root domain) name.
CF_ZONE_ID=
CF_ZONE_NAME=example.com
DNS_TTL=60
DNS_SYNC_INTERVAL=300
# Set only if public IP autodetection is wrong (e.g. behind NAT with a
# known static address).
PUBLIC_IP=

# --- Optional -----------------------------------------------------------------
# Only if your nodes run with their own basic auth. Read the README caveat first.
NODE_PROXY_USER=
NODE_PROXY_PASS=

STATUS_PORT=9000
