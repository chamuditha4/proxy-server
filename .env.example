# ============================================================================
# Proxy NODE configuration
# ============================================================================
# A node is an exit server. It NEVER authenticates clients — the gateway does.
# Pick ONE deployment mode below.

# ----------------------------------------------------------------------------
# MODE A — Docker + mesh   (recommended)   docker-compose.mesh.yml
# ----------------------------------------------------------------------------
# NetBird runs in a container beside the proxy. Nothing is installed on the
# host and no port is ever public. These three are all you need:

# Node name. Becomes mesh hostname "proxy-<NODE_NAME>" AND the proxy username
# clients use. Convention: <region>-<number>, e.g. de-1  (de-1, de-2 -> group "de").
NODE_NAME=

# NetBird setup key that auto-assigns the 'proxy-node' group (your proxy-nodes key).
NB_SETUP_KEY=

# Rarely changed.
PROXY_PORT=8899
# Only when self-hosting NetBird:
# NB_MANAGEMENT_URL=https://api.netbird.io

# ----------------------------------------------------------------------------
# MODE A2 — all-in-one image, env vars only    docker/Dockerfile.aio
# ----------------------------------------------------------------------------
# One container (mesh client + proxy) for platforms that only let you set env
# vars: Railway, Render, Fly, Koyeb, Cloud Run. No capabilities, no devices,
# no volumes. Set MESH=tailscale — NetBird needs kernel WireGuard and cannot
# run there. Use an EPHEMERAL, pre-authorized, TAGGED auth key: state is kept
# in memory, so the peer re-registers on each deploy.
#
#   MESH=tailscale
#   NODE_NAME=de-1
#   TS_AUTHKEY=tskey-auth-xxxxxxxx
#
# Optional: NODE_TAG (default tag:proxy-node), TS_STATE (default mem:),
# TS_LOGIN_SERVER for Headscale, TS_EXTRA_ARGS appended to `tailscale up`.
# PROXY_PORT is taken from the platform's $PORT when you don't set it.
#
# MESH=none skips the mesh entirely and serves a public, authenticated proxy —
# it then REQUIRES PROXY_USER and PROXY_PASS, and you register the node with
# the gateway via STATIC_NODES + NODE_PROXY_USER/NODE_PROXY_PASS.

# ----------------------------------------------------------------------------
# MODE B — standalone / host-installed     docker-compose.yml
# ----------------------------------------------------------------------------
# Only for running the proxy directly (or via scripts/install-node.sh, which
# joins the mesh on the host and fills NODE_BIND_IP for you). The variables
# below are IGNORED by Mode A.

# Address the proxy binds to. Defaults to loopback, so a missing value exposes
# NOTHING rather than everything. install-node.sh sets this to the mesh IP;
# set it to 0.0.0.0 only to expose the proxy publicly.
NODE_BIND_IP=

# Basic auth for the node itself.
#   Behind a gateway: LEAVE BOTH EMPTY — the gateway authenticates.
#   Exposed directly to the internet: set BOTH, or you have an open proxy.
PROXY_USER=
PROXY_PASS=
