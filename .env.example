# Proxy Node Configuration
PROXY_PORT=8899

# The server's Tailscale IPv4 address (100.x.y.z). scripts/install-node.sh
# fills this in automatically. Leave unset and the proxy binds to loopback only.
NODE_BIND_IP=

# Basic auth for the node itself.
#
# Behind a gateway: LEAVE THESE EMPTY. The node is reachable only over the
# tailnet and the gateway does authentication. See README "Node auth".
#
# Standalone (node exposed directly): set both.
PROXY_USER=
PROXY_PASS=
